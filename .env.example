# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# MICROSOFT AZURE DATABASE FOR MYSQL FLEXIBLE SERVER (PRODUCTION)
# ==============================================================================
# High-concurrency connection pool (30 pooled connections for 100+ concurrent operators)
# TLS/SSL 1.2+ is enforced automatically by default on Azure Flexible Server.

# Method 1: Azure MySQL Connection URI
# Example: mysql://<myadmin>:<mypassword>@<myazure-server>.mysql.database.azure.com:3306/<database>?ssl-mode=REQUIRED
AZURE_MYSQL_URL="mysql://azureuser:SecurePassword123!@my-infra-mysql-flex.mysql.database.azure.com:3306/road_infra_erp"
DATABASE_URL="mysql://azureuser:SecurePassword123!@my-infra-mysql-flex.mysql.database.azure.com:3306/road_infra_erp"

# Method 2: Discrete Azure MySQL Parameters
AZURE_MYSQL_HOST="my-infra-mysql-flex.mysql.database.azure.com"
AZURE_MYSQL_PORT="3306"
AZURE_MYSQL_USER="azureuser"
AZURE_MYSQL_PASSWORD=""
AZURE_MYSQL_DATABASE="road_infra_erp"
AZURE_MYSQL_SSL="true"
AZURE_MYSQL_SSL_REJECT_UNAUTHORIZED="false"

# ==============================================================================
# AWS S3 CLOUD STORAGE (EVIDENCE VAULT & ATTACHMENTS)
# ==============================================================================
# Used for storing weighbridge camera tickets, bitumen lab certificates, & delivery challans
AWS_S3_BUCKET="road-infra-evidence-vault"
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Optional AWS S3 session token or custom domain / endpoint
# AWS_SESSION_TOKEN=""
# AWS_S3_ENDPOINT=""
# AWS_S3_CUSTOM_DOMAIN=""
# AWS_S3_FORCE_PATH_STYLE="false"
